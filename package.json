{
  "name": "kids-games-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "boundary:check": "./scripts/check-boundaries.sh",
    "games:conformance": "./scripts/check-game-structure.sh",
    "prebuild:internal": "pnpm --filter @kids-games/shared build && pnpm --filter @kids-games/game-sdk build && pnpm --filter @kids-games/flashcards-backend-adapter build && pnpm --filter @kids-games/tic-tac-toe-backend-adapter build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:unit": "pnpm --filter @kids-games/shared test && pnpm --filter @kids-games/game-sdk test && pnpm --filter @kids-games/api test:unit",
    "test:integration": "pnpm --filter @kids-games/api test:integration",
    "test:web": "pnpm --filter @kids-games/web test",
    "test:e2e:direct": "pnpm --filter @kids-games/web test:e2e",
    "test:e2e": "./dev.sh test:e2e",
    "test": "pnpm typecheck && pnpm lint && pnpm boundary:check && pnpm games:conformance && pnpm test:unit",
    "test:full": "./dev.sh test:full",
    "db:migrate": "pnpm --filter @kids-games/api db:migrate",
    "db:migrate:down": "pnpm --filter @kids-games/api db:migrate:down",
    "db:seed": "pnpm --filter @kids-games/api db:seed",
    "db:reset": "pnpm --filter @kids-games/api db:reset",
    "stack:backup": "./infra/podman/scripts/backup.sh",
    "stack:restore": "./infra/podman/scripts/restore.sh",
    "test:e2e:stack": "pnpm --filter @kids-games/web test:e2e:stack",
    "stack:verify": "./infra/podman/basic-actions-test.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
