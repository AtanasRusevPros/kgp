FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/game-sdk/package.json ./packages/game-sdk/
COPY games/flashcards/backend-adapter/package.json ./games/flashcards/backend-adapter/
COPY server/package.json ./server/
RUN pnpm install --frozen-lockfile --filter @kids-games/api...

# Build
FROM deps AS build
COPY packages/ ./packages/
COPY games/ ./games/
COPY server/ ./server/
COPY tsconfig.base.json ./
RUN pnpm --filter @kids-games/shared build \
 && pnpm --filter @kids-games/flashcards-backend-adapter build \
 && pnpm --filter @kids-games/api build

# Runtime
FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/packages ./packages
COPY --from=build /app/games ./games
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server/node_modules ./server/node_modules
COPY server/src/db/migrations ./server/dist/db/migrations
COPY server/src/db/seed-data ./server/dist/db/seed-data

EXPOSE 3000
ENV NODE_ENV=production
ENV PATH="/app/server/node_modules/.bin:${PATH}"
CMD ["node", "server/dist/index.js"]
