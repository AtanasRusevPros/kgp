FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/game-sdk/package.json ./packages/game-sdk/
COPY games/flashcards/backend-adapter/package.json ./games/flashcards/backend-adapter/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --filter @kids-games/api...

# Build
FROM deps AS build
COPY packages/ ./packages/
COPY games/ ./games/
COPY apps/api/ ./apps/api/
COPY tsconfig.base.json ./
RUN pnpm --filter @kids-games/shared build \
 && pnpm --filter @kids-games/flashcards-backend-adapter build \
 && pnpm --filter @kids-games/api build

# Runtime
FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/packages ./packages
COPY --from=build /app/games ./games
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
COPY apps/api/src/db/migrations ./apps/api/dist/db/migrations
COPY apps/api/src/db/seed-data ./apps/api/dist/db/seed-data

EXPOSE 3000
ENV NODE_ENV=production
ENV PATH="/app/apps/api/node_modules/.bin:${PATH}"
CMD ["node", "apps/api/dist/index.js"]
