FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@latest --activate

# Install dependencies
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json ./packages/shared/
COPY frontend/web/package.json ./frontend/web/
RUN pnpm install --frozen-lockfile --filter @kids-games/web...

# Build
FROM deps AS build
COPY packages/ ./packages/
COPY games/ ./games/
COPY frontend/web/ ./frontend/web/
COPY tsconfig.base.json ./
RUN pnpm --filter @kids-games/web build
RUN grep -R "This game is not available" /app/frontend/web/dist >/dev/null

# Serve with nginx
FROM docker.io/library/nginx:alpine AS runtime
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/frontend/web/dist/. /usr/share/nginx/html/
COPY infra/podman/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
